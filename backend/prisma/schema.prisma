generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String                @id @default(uuid())
  name             String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  accounts         Account[]
  assets           Asset[]
  liabilities      Liability[]
  banks            Bank[]
  financialRecords FinancialRecord[]
  loans            Loan[]
  transactions     Transaction[]
  categories       TransactionCategory[]
  transactionTypes TransactionType[]
  users            User[]
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  roleId           String?
  organizationId   String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  assets           Asset[]
  liabilities      Liability[]
  financialRecords FinancialRecord[]
  loans            Loan[]
  sessions         Session[]
  transactions     Transaction[]
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  role             Role?             @relation(fields: [roleId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  permissions Permission[]
  users       User[]
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  resource  String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bank {
  id             String        @id @default(uuid())
  organizationId String?
  code           String
  name           String
  color          String?
  createdAt      DateTime      @default(now())
  accounts       Account[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}

model Account {
  id               String            @id @default(uuid())
  organizationId   String?
  userId           String
  name             String
  type             AccountType
  bankId           String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accountNumber    String            @default("-")
  actualDate       DateTime?
  bank             Bank?             @relation(fields: [bankId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset            Asset?
  liability        Liability?
  financialRecords FinancialRecord[]
  transactions     Transaction[]
}

model Asset {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String
  accountId      String        @unique
  amount         Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  loans          Loan[]
}

model Liability {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String
  accountId      String        @unique
  amount         Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  loans          Loan[]
}

model FinancialRecord {
  id             String              @id @default(uuid())
  organizationId String?
  userId         String
  accountId      String
  amount         Float
  date           DateTime            @default(now())
  type           FinancialRecordType
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransactionType {
  id             String                @id @default(uuid())
  organizationId String?
  name           String
  behavior       TransactionBehavior
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  transactions   Transaction[]
  categories     TransactionCategory[]
  organization   Organization?         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model TransactionCategory {
  id             String          @id @default(uuid())
  organizationId String?
  name           String
  typeId         String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  type           TransactionType @relation(fields: [typeId], references: [id])

  @@unique([organizationId, name, typeId])
}

model Transaction {
  id                  String              @id @default(uuid())
  organizationId      String?
  userId              String
  accountId           String
  categoryId          String
  typeId              String
  assetId             String?
  liabilityId         String?
  amount              Float
  description         String?
  date                DateTime            @default(now())
  note                String?
  loanId              String?
  linkedTransactionId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  actualDate          DateTime?
  category            TransactionCategory @relation(fields: [categoryId], references: [id])
  account             Account             @relation(fields: [accountId], references: [id])
  loan                Loan?               @relation(fields: [loanId], references: [id])
  organization        Organization?       @relation(fields: [organizationId], references: [id])
  type                TransactionType     @relation(fields: [typeId], references: [id])
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset               Asset?              @relation(fields: [assetId], references: [id])
  liability           Liability?          @relation(fields: [liabilityId], references: [id])
  linkedTransaction   Transaction?        @relation("LinkedTransactions", fields: [linkedTransactionId], references: [id])
  linkedFrom          Transaction[]       @relation("LinkedTransactions")
}

model Loan {
  id             String        @id @default(uuid())
  organizationId String?
  code           String?
  userId         String
  accountId      String
  assetId        String?
  liabilityId    String?
  name           String
  totalAmount    Float         @default(0)
  status         String        @default("ACTIVE")
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  actualDate     DateTime?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  asset          Asset?        @relation(fields: [assetId], references: [id])
  liability      Liability?    @relation(fields: [liabilityId], references: [id])
}

enum FinancialRecordType {
  ASSET
  LIABILITY
}

enum AccountType {
  BANK
  STOCK
  GOLD
  CASHFLOW
  INTERNAL
  EMERGENCY
  GOAL
  INVESTMENT
  SAVING
  FAMILY
  LIABILITY
}

enum TransactionBehavior {
  INCOME
  EXPENSE
  SAVING
  INVESTMENT
  GOAL
  GOAL_SAVING
  EMERGENCY
  INTERNAL_TRANSFER
  DEBT
  LOAN_BORROW
  LOAN_REPAY
}

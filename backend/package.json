{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=local tsx watch src/server.ts",
    "dev:stg": "cross-env NODE_ENV=staging tsx watch src/server.ts",
    "dev:staging": "npm run dev:stg",
    "dev:prod": "cross-env NODE_ENV=production tsx watch src/server.ts",
    "test": "cross-env NODE_ENV=staging vitest run",
    "test:coverage": "cross-env NODE_ENV=staging vitest run --coverage",
    "seed:local": "cross-env NODE_ENV=local tsx prisma/seed.ts",
    "seed:stg": "cross-env NODE_ENV=staging tsx prisma/seed.ts",
    "db:push:local": "cross-env NODE_ENV=local npx prisma db push",
    "db:push:stg": "cross-env NODE_ENV=staging npx prisma db push",
    "reset:stg": "cross-env NODE_ENV=staging npx prisma db push --force-reset & cross-env NODE_ENV=staging tsx prisma/seed.ts",
    "backup:prod": "tsx scripts/backup-neon.ts",
    "bot:discord": "cross-env NODE_ENV=local tsx ../scripts/discord-agent-bot.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@google/generative-ai": "^0.24.1",
    "@line/bot-sdk": "^11.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-raw-body": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}

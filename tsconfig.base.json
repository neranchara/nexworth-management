{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@nexworth/database": ["./packages/database/index.ts"],
      "@nexworth/ai-engine": ["./packages/ai-engine/src/index.ts"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@nexworth/database": ["./packages/database/dist/index.d.ts"],
      "@nexworth/ai-engine": ["./packages/ai-engine/dist/index.d.ts"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"]
}

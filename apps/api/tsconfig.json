{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node", "nodemailer"]
  },

  "include": ["src/**/*.ts", "../../packages/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/tests",
    "../../packages/**/node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "../../packages/**/*.test.ts",
    "../../packages/**/*.spec.ts"
  ]
}

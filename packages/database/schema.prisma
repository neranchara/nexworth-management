generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String                     @id @default(uuid())
  name             String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  isActive         Boolean                    @default(true)
  accounts         Account[]
  assets           Asset[]
  auditLogs        AuditLog[]
  banks            Bank[]
  financialRecords FinancialRecord[]
  goals            Goal[]
  liabilities      Liability[]
  loans            Loan[]
  monthlySnapshots MonthlyFinancialSnapshot[]
  roles            Role[]
  transactions     Transaction[]
  categories       TransactionCategory[]
  transactionTypes TransactionType[]
  users            User[]
  invitations      Invitation[]
}

model User {
  id               String                     @id @default(uuid())
  email            String                     @unique
  passwordHash     String
  firstName        String?
  lastName         String?
  roleId           String?
  organizationId   String?
  isActive         Boolean                    @default(true)
  lineUserId       String?                    @unique
  pairingCode      String?                    @unique
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  isSystemAdmin    Boolean                    @default(false)
  accounts         Account[]
  assets           Asset[]
  financialRecords FinancialRecord[]
  goals            Goal[]
  impersonatedLogs ImpersonationLog[]         @relation("ImpersonatorLogs")
  targetLogs       ImpersonationLog[]         @relation("TargetUserLogs")
  liabilities      Liability[]
  loans            Loan[]
  monthlySnapshots MonthlyFinancialSnapshot[]
  sessions         Session[]
  transactions     Transaction[]
  organization     Organization?              @relation(fields: [organizationId], references: [id])
  role             Role?                      @relation(fields: [roleId], references: [id])
  liquidityDangerZone  Float @default(30000)
  liquiditySafeZone    Float @default(70000)
  savingRateTarget     Float @default(0.20)
  investmentRateTarget Float @default(0.15)
  debtRatioTarget      Float @default(0.30)
  emergencyMonthsTarget Float @default(6.0)
  sentInvitations     Invitation[]               @relation("InvitedBy")
}

model Role {
  id             String        @id @default(uuid())
  name           String
  description    String?
  createdAt      DateTime      @default(now())
  organizationId String?
  isActive       Boolean       @default(true)
  isSystemRole   Boolean       @default(false)
  permissions    Permission[]
  organization   Organization? @relation(fields: [organizationId], references: [id])
  users          User[]
  invitations    Invitation[]

  @@unique([organizationId, name])
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  resource  String
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bank {
  id             String        @id @default(uuid())
  organizationId String?
  code           String
  name           String
  color          String?
  createdAt      DateTime      @default(now())
  accounts       Account[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
}

model Account {
  id               String            @id @default(uuid())
  organizationId   String?
  userId           String
  name             String
  type             String
  bankId           String?
  isActive         Boolean           @default(true)
  isPersonal       Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accountNumber    String            @default("-")
  actualDate       DateTime?
  tag              String?
  targetAmount     Float?
  bank             Bank?             @relation(fields: [bankId], references: [id])
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset            Asset?
  financialRecords FinancialRecord[]
  liability        Liability?
  transactions     Transaction[]
}

model Asset {
  id              String           @id @default(uuid())
  organizationId  String?
  userId          String
  accountId       String           @unique
  amount          Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  note            String?
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalAllocations GoalAllocation[]
  loans           Loan[]
  transactions    Transaction[]

  @@index([userId])
}

model Liability {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String
  accountId      String        @unique
  amount         Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  note           String?
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans          Loan[]
  transactions   Transaction[]

  @@index([userId])
}

model FinancialRecord {
  id             String              @id @default(uuid())
  organizationId String?
  userId         String
  accountId      String
  amount         Float
  date           DateTime            @default(now())
  type           FinancialRecordType
  note           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organization   Organization?       @relation(fields: [organizationId], references: [id])
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransactionType {
  id               String                @id @default(uuid())
  organizationId   String?
  name             String
  behavior         TransactionBehavior
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  defaultDirection String?               // 'INBOUND' | 'OUTBOUND' | 'NEUTRAL'
  isExpenseLike    Boolean               @default(false)
  cashflowBucket   String?               // 'income' | 'expense' | 'saving' | 'debt' | 'invest' | 'loan'
  transactions     Transaction[]
  categories       TransactionCategory[]
  organization     Organization?         @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model TransactionCategory {
  id             String          @id @default(uuid())
  organizationId String?
  name           String
  typeId         String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  systemKey      String?         // 'TRANSFER_IN' | 'TRANSFER_OUT' | 'LOAN_BORROW_SYS' | 'LOAN_REPAY_SYS'
  transactions   Transaction[]
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  type           TransactionType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, typeId])
  @@index([organizationId, systemKey])
}

model Transaction {
  id                  String              @id @default(uuid())
  organizationId      String?
  userId              String
  accountId           String
  categoryId          String
  typeId              String
  amount              Float
  description         String?
  date                DateTime            @default(now())
  note                String?
  loanId              String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  actualDate          DateTime?
  assetId             String?
  liabilityId         String?
  linkedTransactionId String?
  direction           String?
  taxAmount           Float?              @default(0)
  taxType             String?
  transactionType     String?
  account             Account             @relation(fields: [accountId], references: [id])
  asset               Asset?              @relation(fields: [assetId], references: [id])
  category            TransactionCategory @relation(fields: [categoryId], references: [id])
  liability           Liability?          @relation(fields: [liabilityId], references: [id])
  linkedTransaction   Transaction?        @relation("LinkedTransactions", fields: [linkedTransactionId], references: [id])
  linkedFrom          Transaction[]       @relation("LinkedTransactions")
  loan                Loan?               @relation(fields: [loanId], references: [id])
  organization        Organization?       @relation(fields: [organizationId], references: [id])
  type                TransactionType     @relation(fields: [typeId], references: [id])
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, date])
}

model Loan {
  id             String        @id @default(uuid())
  organizationId String?
  code           String?
  userId         String
  accountId      String
  name           String
  totalAmount    Float         @default(0)
  status         String        @default("ACTIVE")
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  actualDate     DateTime?
  assetId        String?
  liabilityId    String?
  asset          Asset?        @relation(fields: [assetId], references: [id])
  liability      Liability?    @relation(fields: [liabilityId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
}

model AuditLog {
  id             String        @id @default(uuid())
  action         String
  entity         String
  entityId       String
  organizationId String?
  oldValue       Json?
  newValue       Json?
  performedBy    String?
  createdAt      DateTime      @default(now())
  ipAddress      String?
  userAgent      String?
  riskTag        String?       @default("NORMAL")
  reason         String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String?  @default("GENERAL")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model ImpersonationLog {
  id              String    @id @default(uuid())
  impersonatorId  String
  targetUserId    String
  ticketReference String
  accessIp        String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  impersonator    User      @relation("ImpersonatorLogs", fields: [impersonatorId], references: [id])
  targetUser      User      @relation("TargetUserLogs", fields: [targetUserId], references: [id])

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([startedAt])
}

model Goal {
  id             String           @id @default(uuid())
  organizationId String?
  userId         String
  name           String
  targetAmount   Float
  color          String           @default("Emerald")
  deadline       DateTime?
  status         String           @default("ACTIVE")
  priority       String           @default("NORMAL")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations    GoalAllocation[]

  @@index([organizationId])
  @@index([userId])
}

model GoalAllocation {
  id              String   @id @default(uuid())
  goalId          String
  assetId         String
  allocatedAmount Float    @default(0)
  lastUpdated     DateTime @default(now()) @updatedAt
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, assetId])
}

model MonthlyFinancialSnapshot {
  id               String        @id @default(uuid())
  organizationId   String?
  userId           String
  monthYear        String
  totalAssets      Float         @default(0)
  totalLiabilities Float         @default(0)
  totalIncome      Float         @default(0)
  totalExpense     Float         @default(0)
  savingsRate      Float         @default(0)
  netWorth         Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization? @relation(fields: [organizationId], references: [id])
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthYear])
}

enum FinancialRecordType {
  ASSET
  LIABILITY
}

enum AccountType {
  BANK
  STOCK
  GOLD
  CASHFLOW
  INTERNAL
  EMERGENCY
  GOAL
  INVESTMENT
  SAVING
  FAMILY
  LIABILITY
}

enum TransactionBehavior {
  INCOME
  EXPENSE
  SAVING
  INVESTMENT
  GOAL_SAVING
  INTERNAL_TRANSFER
  DEBT
  LOAN_BORROW
  LOAN_REPAY
  GOAL
  EMERGENCY
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([name])
}

model SystemLog {
  id        String   @id @default(uuid())
  type      String   // e.g., "telemetry", "performance", "error"
  tag       String?  // e.g., "ai-engine", "db-query"
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, tag])
  @@index([createdAt])
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invitation {
  id              String           @id @default(uuid())
  email           String
  organizationId  String
  roleId          String
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy       User             @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([organizationId])
}

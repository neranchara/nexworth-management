{
  "name": "nexworth-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@nexworth/api",
    "dev:bot": "npm run dev --workspace=@nexworth/bot",
    "dev:web": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate --workspace=@nexworth/database",
    "db:push": "npm run db:push --workspace=@nexworth/database",
    "start:api": "npm run start --workspace=@nexworth/api",
    "start:bot": "npm run start --workspace=@nexworth/bot",
    "start:web": "npm run start --workspace=frontend"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.15.2",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2"
  }
}

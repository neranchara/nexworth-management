{
  "name": "nexworth-workspace",
  "version": "1.0.0",
  "scripts": {
    "test": "npx playwright test",
    "test:frontend": "npx playwright test tests/playwright/frontend",
    "test:backend": "npx playwright test tests/playwright/backend",
    "dev:all": "concurrently \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\""
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2"
  }
}
